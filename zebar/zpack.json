{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "winsome",
  "version": "0.1.0",
  "description": "The Winsome bar: GlazeWM workspaces, systray, supervisor health dot, clock and stats. Forked from glzr-io.starter's with-glazewm widget.",
  "tags": [
    "topbar",
    "winsome"
  ],
  "previewImages": [],
  "repositoryUrl": "https://github.com/railapex/winsome",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "C:/Users/chris/.winsome/bin/winsome.exe",
            "argsRegex": "^status --json$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}