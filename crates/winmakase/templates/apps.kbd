;; Generated by `winmakase kanata render` (mode = apps) — do not edit.
;; menu key: tap = context menu (native), hold = WM chord (Ctrl+Alt+Win — no
;; Shift: Ctrl+Alt+Shift+Win is the Office key, and Shift must stay free for
;; the mod+Shift+X grammar). Caps Lock is untouched in this mode — the raw
;; exit that caps mode's scrlk hatch guarantees is simply native here.
;;
;; CAUTION: validated but never live-tested (M0 straggler). The two-hooks
;; finding (spike/NOTES.md) predicts desync risk for synthesized multi-mod
;; chords consumed by GlazeWM; caps mode is the proven architecture.
(defcfg
  process-unmapped-keys yes
)

(defsrc menu)

(deflayer base @app)

(defalias
  app (tap-hold-press {tap_ms} {hold_ms} menu (multi lctl lalt lmet))
)
