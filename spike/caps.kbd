;; Winsome spike — caps mode, v4 RESTORED (holding state while keybinding architecture is reviewed)
;; caps = Win key, pure modifier. Launcher = Caps+Space (PT Run activation = Win+Space).
;; scrlk = real CapsLock (escape hatch). Bare caps tap = Start menu (native).
;; 0ms chord path: GlazeWM binds real lwin chords; kanata synthesizes ONLY the modifier.
;; v5 direct-drive parked: kanata cmd broke on spaced paths + console flash; wscript
;; shim fixed both but costs 60-100ms/press — rejected. See spike/NOTES.md.
(defcfg
  process-unmapped-keys no
)

(defsrc caps slck)

(deflayer base lmet caps)
