;; Winsome spike — caps mode, v3 (real-Super architecture)
;; caps: tap = Alt+Space (launcher) · hold = REAL Win key (lmet)
;; scrlk = real CapsLock — Chris's escape hatch, now a permanent design rule.
;; process-unmapped-keys OFF: kanata touches ONLY caps/scrlk; every other key
;; passes through raw, so GlazeWM consuming bound chords can never desync
;; kanata's state tracking (the llhook:215 failure of v1/v2).
;; Known trap: caps+L = Win+L = OS lock (winlogon-level, uninterceptable). L unbound.
(defcfg
  process-unmapped-keys no
)

(defsrc caps slck)

(deflayer base @cap caps)

(defalias
  cap (tap-hold-press 200 200 A-spc lmet)
)
