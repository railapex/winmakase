;; Winsome spike — caps mode, v4 (pure modifier — no tap-hold)
;; caps = Win key, full stop. Launcher = Caps+Space (PT Run activation set to
;; Win+Space — omarchy's exact Super+Space motion). scrlk = real CapsLock (escape hatch).
;; v3's tap-hold raced: with process-unmapped-keys off kanata can't see the
;; interrupting key, so fast chords leaked the letter raw and a bare caps
;; release opened the Start menu. Pure modifier has no decision to race.
;; Bare caps tap = bare Win tap = Start menu (native Windows behavior).
(defcfg
  process-unmapped-keys no
)

(defsrc caps slck)

(deflayer base lmet caps)
